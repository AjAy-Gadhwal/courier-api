{
  "name": "courier-api",
  "version": "1.0.0",
  "description": "Multi-courier integration platform (unified shipping API, Express + Sequelize + MySQL)",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "healthcheck": "node scripts/healthcheck.js"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
